APP_NAME=payout-calculation-service
APP_ENV=local
LOG_LEVEL=debug

HTTP_PORT=8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s

DB_URL=postgres://payout:payout@localhost:5432/payout?sslmode=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=15m
MIGRATIONS_PATH=./migrations

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PAYOUT_TTL=10m
REDIS_PAYOUT_LIST_TTL=2m
REDIS_COURIER_TTL=10m

JWT_SECRET=#hello-world-test-jwt-secret-1899
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
JWT_ISSUER=payout-calculation-service

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

PAYOUT_JOB_ENABLED=true
PAYOUT_JOB_CRON=0 0 1 * *
